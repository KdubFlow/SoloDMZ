// Grafana Alloy (siem-alloy) - liest die Log-Verzeichnisse der VM und schreibt an Loki.
// Out-of-Band (SF-11): kein Netzpfad aus der DMZ ins SOC noetig.

local.file_match "sun" {
  path_targets = [
    { "__path__" = "/var/log/sun/**/*.log",  "job" = "sun-text" },
    { "__path__" = "/var/log/sun/**/*.json", "job" = "sun-json" },
  ]
}

loki.source.file "sun" {
  targets    = local.file_match.sun.targets
  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://10.0.30.11:3100/loki/api/v1/push"
  }
}
