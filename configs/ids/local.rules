# =============================================================================
#  IDS local.rules - passive Erkennung (SF-09). SID-Bereich 1000000+.
#  Diese Regeln MELDEN nur (alert). Die Drop-Varianten stehen in ../ips/.
# =============================================================================

# --- Aufklaerung / Portscan (Test 02, Kette A3 / B1) ---
alert tcp any any -> $HOME_NET any (msg:"SUN Portscan erkannt (viele SYN)"; \
  flags:S; threshold:type both, track by_src, count 20, seconds 5; \
  classtype:attempted-recon; sid:1000001; rev:1;)

# --- SSH-Zugriff auf den Honeypot (Test 23, Kette A/B) ---
alert tcp any any -> 10.0.10.50 2222 (msg:"SUN Honeypot beruehrt"; \
  flow:to_server; classtype:policy-violation; sid:1000002; rev:1;)

# --- C2-Anomalie: Verkehr auf 443 ohne TLS-Handshake (Test 09, Kette A2) ---
alert tcp any any -> any 443 (msg:"SUN Port 443 ohne TLS (moegliches C2)"; \
  flow:to_server,established; app-layer-protocol:!tls; \
  classtype:trojan-activity; sid:1000003; rev:1;)

# --- Skript-Download aus dem Internet (Kette A1) ---
alert http any any -> $HOME_NET any (msg:"SUN ausfuehrbarer/Skript-Download"; \
  flow:to_client; file.name; content:".sh"; endswith; \
  classtype:policy-violation; sid:1000004; rev:1;)

# --- SQLi-Muster (Sichtbarkeit zusaetzlich zur WAF, Test 03) ---
alert http any any -> $HOME_NET any (msg:"SUN SQLi-Muster in URI"; \
  flow:to_server,established; http.uri; content:"union"; nocase; content:"select"; nocase; distance:0; \
  classtype:web-application-attack; sid:1000005; rev:1;)

# --- Grosse Ausleitung Richtung Internet (Kette A5, ergaenzt SF-16) ---
alert tcp $HOME_NET any -> any 443 (msg:"SUN grosser Upload Richtung Internet"; \
  flow:to_server,established; threshold:type both, track by_src, count 1, seconds 60; \
  classtype:policy-violation; sid:1000006; rev:1;)
